# DNS-01 credentials for Traefik's wildcard cert. Copy to dns.env (gitignored)
# and fill in the token for whatever provider domain.dns_provider names in
# event.yml. Traefik uses lego under the hood; each provider reads its own env
# vars - see https://go-acme.github.io/lego/dns/ for the full list.
#
# We use DigitalOcean:
DO_AUTH_TOKEN=dop_v1_your_digitalocean_api_token_with_dns_write

# Other providers, for reference (uncomment the set that matches dns_provider):
# Cloudflare:   CF_DNS_API_TOKEN=...
# Route53:      AWS_ACCESS_KEY_ID=...   AWS_SECRET_ACCESS_KEY=...   AWS_REGION=...
# Gandi:        GANDIV5_PERSONAL_ACCESS_TOKEN=...
