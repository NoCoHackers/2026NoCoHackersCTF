# Template for the encrypted flag file.
#
# The real file is deploy/chals/flags.enc.env, encrypted with sops+age and
# committed; it decrypts to flags.env on the host at deploy time (`make up`).
# One variable per runnable scoreboard entry. The primary remains
# FLAG_<SERVICE>; supplemental entries append an explicit entry delimiter, for
# example FLAG_MISC_DEVICE__ENTRY_UART. Generate the plaintext list with:
#
#   python3 tools/chalbundle.py env

FLAG_WEB_HAUNTED_BREWERY=noco{old_town_never_stopped_pouring}
FLAG_PWN_CELLAR_DOOR=noco{the_door_was_never_really_locked}
