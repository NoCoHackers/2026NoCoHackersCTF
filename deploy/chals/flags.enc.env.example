# Template for the encrypted flag file.
#
# The real file is deploy/chals/flags.enc.env, encrypted with sops+age and
# committed; it decrypts to flags.env on the host at deploy time (`make up`).
# One variable per runnable challenge, named FLAG_<SERVICE> where <SERVICE> is
# the generated container name upper-cased with dashes as underscores.
#
# Generate this list from the challenges so it never drifts:
#   for d in $(find challenges -name challenge.yml -not -path '*/TEMPLATE/*' -printf '%h\n'); do
#     name=$(basename "$(dirname "$d")")-$(basename "$d")
#     var=FLAG_$(echo "$name" | tr 'a-z-' 'A-Z_')
#     flag=$(python3 tools/chalmeta.py "$d" | sed -n "s/^CHAL_FLAG=//p" | tr -d "'")
#     echo "$var=$flag"
#   done

FLAG_WEB_HAUNTED_BREWERY=noco{old_town_never_stopped_pouring}
FLAG_PWN_CELLAR_DOOR=noco{the_door_was_never_really_locked}
