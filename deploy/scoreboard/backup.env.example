# Install as /etc/noco/backup.env with mode 600 on the scoreboard host.
# MYSQL_ROOT_PASSWORD must match deploy/scoreboard/.env.
MYSQL_ROOT_PASSWORD=change-me

# rclone destination. Configure the named remote for the noco deploy user.
NOCO_BACKUP_REMOTE=remote:noco-ctf
NOCO_BACKUP_DIR=/var/backups/noco
NOCO_BACKUP_KEEP=48
