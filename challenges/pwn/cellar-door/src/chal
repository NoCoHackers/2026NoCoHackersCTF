#!/bin/sh
echo "NIGHT MANAGER TERMINAL // Linden St. cellar"
echo "type 'help' if you've forgotten the word again, Earl. 'quit' to leave."
while :; do
  printf '> '
  IFS= read -r cmd || break
  case "$cmd" in
    help)      echo "Earl's note taped to the monitor: the word is 'sourdough'" ;;
    sourdough) cat /flag.txt; break ;;
    quit)      echo "goodnight."; break ;;
    *)         echo "the door stays shut." ;;
  esac
done
